{
    "breadcrumbs.enabled": false,
    "chat.disableAIFeatures": false,
    "chat.mcp.access": "none",
    "editor.cursorBlinking": "blink",
    "editor.cursorStyle": "line",
    "editor.insertSpaces": true,
    "editor.minimap.enabled": false,
    "editor.fontSize": 16,
    "editor.fontLigatures": true,
    "editor.lineHeight": 1.2,
    "editor.linkedEditing": true,
    "editor.scrollbar.horizontal": "auto",
    "editor.scrollbar.vertical": "auto",
    "editor.scrollbar.horizontalSliderSize": 5,
    "editor.scrollbar.verticalSliderSize": 5,
    "editor.renderLineHighlight": "none",
    "editor.tabSize": 4,
    "terminal.integrated.fontLigatures.enabled": true,
    "terminal.integrated.lineHeight": 1.2,
    "telemetry.feedback.enabled": false,
    "telemetry.telemetryLevel": "off",
    "window.zoomLevel": 0.3,
    "window.commandCenter": false,
    "workbench.activityBar.location": "bottom",
    "workbench.navigationControl.enabled": false,
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.layoutControl.enabled": true,
    "workbench.layoutControl.type": "both",
    "workbench.sideBar.location": "right",
    "scm.alwaysShowRepositories": true,
    "workbench.startupEditor": "none",
    "workbench.statusBar.visible": false,
    "workbench.editor.revealIfOpen": true,
    "flow-icons.licenseKey": "FLOW-KEY",
    "zenMode.fullScreen": false,
    "zenMode.centerLayout": false,
    "workbench.iconTheme": "flow-deep",
    "editor.autoIndent": "full",
    "editor.detectIndentation": false,
    "editor.autoIndentOnPaste": false,
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false,
    "editor.formatOnType": true,
    "editor.codeActionsOnSave": {
        "source.fixAll": "never",
        "source.organizeImports": "never"
    },
    "workbench.colorTheme": "Dark 2026",
    "chat.agent.enabled": false,
    "chat.titleBar.openInAgentsWindow.enabled": false,
    "chat.titleBar.signIn.enabled": false,
    "github.copilot.enable": {
        "*": false
    },
    "github.copilot.nextEditSuggestions.enabled": false,
    "containers.composeDetached": true,
    "containers.composeBuild": true,
    "dev.containers.mountWaylandSocket": false,
    "[javascript]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
    },
    "[javascriptreact]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
    },
    "[typescript]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
    },
    "[typescriptreact]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
    }
}
